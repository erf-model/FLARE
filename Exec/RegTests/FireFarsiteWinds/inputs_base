# FireFarsiteWinds: erf.fire.farsite_winds writes the fire layer's reference
# wind as FARSITE/FlamMap gridded winds (ESRI ASCII _vel/_ang grids and a .atm
# file, the layout WindNinja writes). See README.md. This deck holds what the
# two variants share: a small flat domain in three boxes, so two ranks own
# unequal parts of the fire plane and the writer's gather is exercised.
geometry.prob_lo = 0.0 0.0 0.0
geometry.prob_hi = 600.0 200.0 200.0
amr.n_cell = 30 10 10              # 20 m cells; fire grid 60 x 20 cells of 10 m
geometry.is_periodic = 1 1 0
amr.max_level = 0
amr.max_grid_size = 10             # three boxes in x
amr.max_grid_size_z = 10

zlo.type = "surface_layer"
zhi.type = "SlipWall"
erf.most.z0 = 0.1
erf.most.surf_temp = 300.0
erf.most.surf_heating_rate = 0.0

erf.molec_diff_type = "None"
erf.les_type = "Smagorinsky"
erf.Cs = 0.1
erf.use_gravity = true
erf.use_coriolis = false
erf.theta_ref = 300.0

erf.init_type = "input_sounding"
erf.input_sounding_file = "input_sounding"
erf.sounding_type = Ideal

erf.fixed_dt = 1.0
erf.substepping_cfl = 0.5
max_step = 125
stop_time = 1000.0

erf.v = 0
amr.v = 0
erf.sum_interval = -1
erf.check_int = -1
erf.plot_int_1 = -1
erf.fire.plot_int = -1

erf.fire.enable = true
erf.fire.grid_ratio = 2
erf.fire.propagation_method = "levelset"
erf.fire.directional_ros = true
erf.fire.fuel_model_id = 1
erf.fire.moisture_1hr = 0.08
erf.fire.moisture_10hr = 0.08
erf.fire.moisture_100hr = 0.08
erf.fire.moisture_dynamic = false
erf.fire.ignition_x = 150.0
erf.fire.ignition_y = 100.0
erf.fire.ignition_r = 15.0
erf.fire.use_waf = false
erf.fire.use_terrain_wind = false
erf.fire.ros_model = "rothermel"
erf.fire.write_fire_stats_csv = false
erf.fire.coupling_type = "lagged"
erf.fire.fire_atm_feedback = 0.0   # one-way: the atmosphere is the sounding's
