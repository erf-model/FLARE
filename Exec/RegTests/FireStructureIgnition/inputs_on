FILE = inputs_base

# The new path: house A ignites from the heat load of the grass burning at its
# wall, burns with a fast curve, and its radiation and brands ignite B 20 m
# away; C, 90 m further, stays unignited. The thresholds and the curve are set for a 20 s
# run, not the documented defaults: the heat-load threshold is one fiftieth of
# the default, the growth time 2 s, and the fuel load small enough that A burns
# out before the end (see the README).
erf.fire.plot_file = "plt_fire_on_"
erf.fire.fire_stats_csv_file = "fire_stats_on.csv"
erf.fire.exposure.file = "exposure_on.csv"
erf.fire.structures.ignition.enable = true
erf.fire.structures.ignition.heat_load_J_m2 = 1.2e5     # 0.12 MJ/m2 (default 6 MJ/m2)
erf.fire.structures.ignition.ember_count = 5             # (default 50)
erf.fire.structures.ignition.intensity_kW_m = 0.0        # criterion off here
erf.fire.structures.ignition.peak_flux_W_m2 = 2.0e5      # test value (default 1e5, a placeholder)
erf.fire.structures.ignition.fuel_load_J_m2 = 1.5e6      # 1.5 MJ/m2: the curve lasts 12.6 s (default 5e8, a placeholder)
erf.fire.structures.ignition.growth_time_s = 2.0         # (default 300 s, a placeholder)
erf.fire.structures.ignition.decay_fraction = 0.5        # the decay releases half the load (the default)
erf.fire.structures.ignition.rad_fraction = 0.3    # the default
erf.fire.structures.ignition.rad_radius_m = 60.0   # (default 100 m)
