# FireWindColumnZ0: a grass fire on flat ground whose reference wind is
# sampled at 20 m and brought down with a neutral log profile. The roughness of
# that profile is erf.fire.wind_sample_z0 (scalar) or the surface layer's z0 of
# each atmospheric column (erf.fire.wind_sample_z0_source = surface_layer).
# One-way coupling, so the atmosphere is the same for both sources and the run
# script compares them cell by cell. This deck has a uniform z0 = 0.1 m, the
# value of erf.fire.wind_sample_z0: both sources must give the same answer.

geometry.prob_lo = 0.0 0.0 0.0
geometry.prob_hi = 320.0 160.0 160.0
amr.n_cell = 64 32 32
geometry.is_periodic = 1 1 0
amr.max_level = 0
amr.max_grid_size = 32      # four boxes: two per rank on two ranks
amr.max_grid_size_z = 32    # fire module forbids z-decomposition

zlo.type = "surface_layer"
zhi.type = "SlipWall"
erf.most.z0 = 0.1
erf.most.surf_temp = 300.0
erf.most.surf_heating_rate = 0.0

erf.molec_diff_type = "None"
erf.les_type = "Smagorinsky"
erf.Cs = 0.1
erf.use_gravity = true
erf.use_coriolis = false
erf.theta_ref = 300.0

erf.init_type = "input_sounding"
erf.input_sounding_file = "input_sounding"   # u = 8, v = 4 m/s: both components are checked
erf.sounding_type = Ideal

erf.fixed_dt = 0.125
erf.substepping_cfl = 0.5
max_step = 4
stop_time = 60.0

erf.v = 0
amr.v = 0
erf.sum_interval = -1
erf.check_int = -1
erf.plot_int_1 = -1
erf.fire.plot_int = 4                 # the step-4 fire plotfile is what the check reads

erf.fire.enable = true
erf.fire.grid_ratio = 4               # 1.25 m fire cells, four per atmospheric column
erf.fire.propagation_method = "levelset"
erf.fire.directional_ros = false
erf.fire.fuel_model_id = 1            # short grass, uniform
erf.fire.moisture_1hr = 0.08
erf.fire.moisture_10hr = 0.08
erf.fire.moisture_100hr = 0.08
erf.fire.moisture_dynamic = false
erf.fire.ignition_x = 100.0
erf.fire.ignition_y = 80.0
erf.fire.ignition_r = 15.0
erf.fire.wind_ref_ht = 6.1
erf.fire.wind_interp = "nearest"      # each fire cell takes its own column's wind and z0
erf.fire.wind_sample_ht = 20.0        # sampled at 20 m, brought to wind_ref_ht with the log profile
erf.fire.wind_sample_z0 = 0.1
erf.fire.wind_sample_z0_source = "scalar"
erf.fire.use_waf = true
erf.fire.waf_formula = "andrews"
erf.fire.use_wind_limit = false       # the check reads the wind before any cap
erf.fire.use_terrain_wind = false
erf.fire.ros_model = "rothermel"
erf.fire.write_fire_stats_csv = false
erf.fire.coupling_type = "lagged"
erf.fire.fire_atm_feedback = 0.0      # one-way: the atmosphere is identical in every run
